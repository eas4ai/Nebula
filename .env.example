APP_NAME="Nebula"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080

# 32-byte AES-256 key (URL-safe base64, no padding). Generate one with
# `suprnova key:generate` and copy it into your `.env`. Required in
# production - Suprnova fails closed on boot when APP_ENV is not
# local/dev/test and APP_KEY is unset.
APP_KEY=

SERVER_HOST=127.0.0.1
SERVER_PORT=8080

# Which frontend the HTML shell renders (svelte | react | vue). The kit
# also pins this in code on the config passed to `Inertia::install`.
SUPRNOVA_FRONTEND=svelte
VITE_PORT=5173

# Response security headers. Unset means balanced, which sends a
# Content-Security-Policy with a fresh nonce for each HTML response.
# strict | balanced | relaxed | off.
SECURITY_HEADERS=balanced
# true sends the policy as Content-Security-Policy-Report-Only: the
# browser reports violations and blocks nothing.
SECURITY_HEADERS_CSP_REPORT_ONLY=false
# SECURITY_HEADERS_CSP_REPORT_TO=https://reports.example.com/csp
SECURITY_HEADERS_HSTS_PRELOAD=false

# Database (SQLite by default, change to postgres://user:pass@localhost:5432/dbname for PostgreSQL)
DATABASE_URL=sqlite://./database.db
DB_MAX_CONNECTIONS=10
DB_MIN_CONNECTIONS=1
DB_CONNECT_TIMEOUT=30
DB_LOGGING=false

# Session
SESSION_LIFETIME=120
SESSION_COOKIE=suprnova_session
# false for local HTTP development; true in production (HTTPS).
SESSION_SECURE=false
# Cookie path. Unset, the session and CSRF cookies take the public root
# of each request: `/`, or the prefix behind a proxy that serves the app
# there. Set it only to pin one path.
# SESSION_PATH=/
SESSION_SAME_SITE=Lax
# Cookie-name prefix for the session and remember-me cookies. "__Host-"
# is the production hardening; it requires HTTPS (SESSION_SECURE=true).
# Leave empty for local HTTP development.
SESSION_COOKIE_PREFIX=

# Mail
MAIL_DRIVER=log
MAIL_FROM="hello@nebula.test"
# To send real mail in dev, run Mailpit (https://github.com/axllent/mailpit) and swap:
#   MAIL_DRIVER=smtp
#   MAIL_SMTP_HOST=localhost
#   MAIL_SMTP_PORT=1025
#   MAIL_SMTP_ENCRYPTION=none
MAIL_SMTP_HOST=localhost
MAIL_SMTP_PORT=1025
MAIL_SMTP_ENCRYPTION=none
# Production: starttls (usually 587) or tls (usually 465), with BOTH credentials.
# MAIL_SMTP_USER=your-provider-user
# MAIL_SMTP_PASS=your-provider-secret
MAIL_FROM_NAME="Suprnova App"

# Error reporting. Copy a project's DSN from Rustrak, Sentry or GlitchTip.
# No DSN sends nothing; logs, transactions and browser reports are opt-in.
# REPORTING_DRIVER=sentry
# REPORTING_DSN=
# REPORTING_RELEASE=
# REPORTING_SEND_PII=false
# REPORTING_LOGS=off
# REPORTING_TRACES_SAMPLE_RATE=0
# The frontend reads this public DSN at build time and reports browser
# errors to it; the security policy reads it from this file too and
# allows the tracker connection.
# VITE_REPORTING_DSN=
